  "grammar": [
    {
      "id": "g1",
      "titre": "Compter de 1 à 10",
      "explication": "En basque on compte : bat (1), bi (2), hiru (3), lau (4), bost (5), sei (6), zazpi (7), zortzi (8), bederatzi (9), hamar (10). Le nombre se place après le nom : « etxe bat » veut dire « une maison ».",
      "exemples": [
        "bat, bi, hiru, lau, bost",
        "sei, zazpi, zortzi, bederatzi, hamar",
        "etxe bat = une maison"
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Le chiffre 3 se dit ___ en basque.",
          "reponse": "hiru"
        },
        {
          "type": "trous",
          "phrase": "Le chiffre 7 se dit ___ en basque.",
          "reponse": "zazpi"
        },
        {
          "type": "trous",
          "phrase": "Le chiffre 10 se dit ___ en basque.",
          "reponse": "hamar"
        },
        {
          "type": "choix",
          "question": "Comment dit-on « cinq » en basque ?",
          "options": ["lau", "bost", "sei"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "Comment dit-on « neuf » en basque ?",
          "options": ["zortzi", "bederatzi", "hamar"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "Que veut dire « bi » ?",
          "options": ["un", "deux", "trois"],
          "bonne": 1
        },
        {
          "type": "ordre",
          "mots": ["bat", "bi", "hiru", "lau", "bost"]
        },
        {
          "type": "ordre",
          "mots": ["sei", "zazpi", "zortzi", "bederatzi", "hamar"]
        }
      ]
    },
    {
      "id": "g2",
      "titre": "Poser une question",
      "explication": "Les mots pour questionner : nor (qui), zer (quoi), non (où), nola (comment), zenbat (combien), nori (à qui). Dans le Labourd on entend aussi nun à la place de non.",
      "exemples": [
        "nor ? = qui ?",
        "non ? = où ?",
        "zenbat ? = combien ?",
        "nola ? = comment ?"
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Pour demander « où », on dit ___ en basque.",
          "reponse": "non"
        },
        {
          "type": "trous",
          "phrase": "Pour demander « combien », on dit ___ en basque.",
          "reponse": "zenbat"
        },
        {
          "type": "trous",
          "phrase": "Pour demander « comment », on dit ___ en basque.",
          "reponse": "nola"
        },
        {
          "type": "choix",
          "question": "Que veut dire « nor » ?",
          "options": ["qui", "quoi", "où"],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "Que veut dire « zer » ?",
          "options": ["qui", "quoi", "combien"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "« Nori » sert à demander…",
