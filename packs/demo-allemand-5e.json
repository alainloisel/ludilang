  "grammar": [
    {
      "id": "g1",
      "titre": "Le présent des verbes",
      "explication": "Au présent, on enlève -en de l'infinitif et on ajoute la terminaison : ich → -e, du → -st, er/sie/es → -t, wir → -en, ihr → -t, sie → -en. Exemple avec spielen : ich spiele, du spielst, er spielt.",
      "exemples": [
        "Ich wohne in Lyon.",
        "Du spielst Fußball.",
        "Er hört Musik."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Ich ___ in Paris. (wohnen)",
          "reponse": "wohne"
        },
        {
          "type": "trous",
          "phrase": "Du ___ Fußball. (spielen)",
          "reponse": "spielst"
        },
        {
          "type": "trous",
          "phrase": "Er ___ Musik. (hören)",
          "reponse": "hört"
        },
        {
          "type": "trous",
          "phrase": "Meine Schwester ___ gern. (tanzen)",
          "reponse": "tanzt"
        },
        {
          "type": "choix",
          "question": "Wir ___ Deutsch.",
          "options": ["lernt", "lernen", "lernst"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "Ihr ___ in Berlin.",
          "options": ["wohnt", "wohnen", "wohne"],
          "bonne": 0
        },
        { "type": "ordre", "mots": ["Ich", "spiele", "gern", "Fußball"] },
        {
          "type": "ordre",
          "mots": ["Meine", "Mutter", "hört", "gern", "Musik"]
        },
        {
          "type": "trous",
          "phrase": "Wir ___ am Wochenende Fußball. (spielen)",
          "reponse": "spielen"
        }
      ]
    },
    {
      "id": "g2",
      "titre": "Les articles der, die, das",
      "explication": "En allemand, chaque nom a un genre : der (masculin), die (féminin), das (neutre). Au pluriel, c'est toujours die. Il faut apprendre l'article avec chaque mot !",
      "exemples": [
        "der Hund, der Bruder (masculin)",
        "die Katze, die Schule (féminin)",
        "das Heft, das Hobby (neutre)"
      ],
      "exercices": [
        {
          "type": "choix",
          "question": "___ Schule",
          "options": ["der", "die", "das"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "___ Heft",
          "options": ["der", "die", "das"],
          "bonne": 2
        },
        {
          "type": "choix",
          "question": "___ Bruder",
          "options": ["der", "die", "das"],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "___ Katze",
          "options": ["der", "die", "das"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "___ Hobby",
          "options": ["der", "die", "das"],
          "bonne": 2
        },
        {
          "type": "trous",
          "phrase": "___ Hund heißt Rex. (article)",
          "reponse": "der"
        },
        {
          "type": "trous",
          "phrase": "___ Katze ist klein. (article)",
          "reponse": "die"
        },
        {
          "type": "trous",
          "phrase": "___ Heft ist neu. (article)",
          "reponse": "Das"
        },
        {
          "type": "trous",
          "phrase": "___ Bruder spielt Fußball. (article)",
          "reponse": "Der"
        },
        {
          "type": "trous",
