  "grammar": [
    {
      "id": "g1",
      "titre": "Le présent simple",
      "explication": "On utilise le présent simple pour les habitudes et les vérités générales. Attention : à la 3e personne du singulier (he, she, it), on ajoute un -s au verbe (ou -es après o, ch, sh…).",
      "exemples": [
        "I play football on Sundays.",
        "She goes to school by bus.",
        "He watches TV in the evening."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "She ___ to school every day. (go)",
          "reponse": "goes"
        },
        {
          "type": "trous",
          "phrase": "He ___ TV in the evening. (watch)",
          "reponse": "watches"
        },
        {
          "type": "trous",
          "phrase": "They ___ football on Sundays. (play)",
          "reponse": "play"
        },
        {
          "type": "trous",
          "phrase": "My sister ___ up at seven. (get)",
          "reponse": "gets"
        },
        {
          "type": "choix",
          "question": "My brother ___ history.",
          "options": ["like", "likes", "liking"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "We ___ breakfast at eight.",
          "options": ["has", "have", "having"],
          "bonne": 1
        },
        { "type": "ordre", "mots": ["She", "gets", "up", "at", "seven"] },
        {
          "type": "ordre",
          "mots": ["I", "brush", "my", "teeth", "every", "morning"]
        }
      ]
    },
    {
      "id": "g2",
      "titre": "Le présent en BE + -ING",
      "explication": "Pour dire ce qui se passe en ce moment, on utilise BE (am / is / are) + verbe en -ING. Exemple : I am reading = je suis en train de lire.",
      "exemples": [
        "Look! It is raining.",
        "I am doing my homework.",
        "They are playing football now."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Look! It ___ raining. (be)",
          "reponse": "is"
        },
        {
          "type": "trous",
          "phrase": "I am ___ my homework. (do)",
          "reponse": "doing"
        },
        {
          "type": "trous",
          "phrase": "They ___ eating a sandwich. (be)",
          "reponse": "are"
        },
        {
          "type": "choix",
          "question": "Listen! She ___ in the bathroom.",
          "options": ["sings", "is singing", "sing"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "We ___ football now.",
          "options": ["are playing", "play", "plays"],
          "bonne": 0
        },
        {
          "type": "ordre",
          "mots": ["They", "are", "playing", "football", "now"]
        },
        { "type": "ordre", "mots": ["He", "is", "doing", "his", "homework"] }
      ]
    },
    {
      "id": "g3",
      "titre": "Can / can't",
      "explication": "CAN exprime la capacité (je sais faire / je peux). Il ne prend jamais de -s et est suivi du verbe sans « to ». La négation est can't (cannot).",
      "exemples": [
        "She can swim very well.",
        "I can't draw.",
        "Can you play football?"
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "She ___ swim very well. (savoir faire)",
          "reponse": "can"
        },
        {
          "type": "trous",
          "phrase": "I ___ draw, sorry! (ne pas savoir faire)",
          "reponse": "can't"
        },
        {
          "type": "choix",
          "question": "My little brother ___ read yet.",
          "options": ["can't", "don't can", "cans not"],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "___ you swim?",
          "options": ["Do can", "Can", "Are"],
          "bonne": 1
        },
        { "type": "ordre", "mots": ["Can", "you", "draw", "a", "dragon?"] },
        { "type": "ordre", "mots": ["I", "can", "swim", "very", "fast"] }
      ]
    },
    {
      "id": "g4",
      "titre": "Les verbes irréguliers (Prétérit)",
      "explication": "Au prétérit (le passé), les verbes réguliers prennent '-ed'. Mais les verbes irréguliers changent de forme et doivent être appris par cœur.",
      "exemples": [
        "I went to the cinema yesterday. (go ➜ went)",
        "We had breakfast at eight. (have ➜ had)",
        "He saw a big dog in the street. (see ➜ saw)"
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Yesterday, I ___ to the cinema. (go)",
          "reponse": "went"
        },
        {
          "type": "trous",
          "phrase": "We ___ breakfast at eight. (have)",
          "reponse": "had"
        },
        {
          "type": "trous",
          "phrase": "He ___ a big dog in the street. (see)",
          "reponse": "saw"
        },
        {
          "type": "trous",
          "phrase": "She ___ a letter to her friend. (write)",
          "reponse": "wrote"
        },
        {
          "type": "choix",
          "question": "Yesterday, we ___ a nice teacher.",
          "options": ["had", "haded", "have"],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "Last night, I ___ a good book.",
          "options": ["readed", "read", "reads"],
          "bonne": 1
        },
        { "type": "ordre", "mots": ["I", "went", "to", "school", "yesterday"] },
        { "type": "ordre", "mots": ["We", "saw", "a", "big", "dog"] }
      ]
    }
  ],
