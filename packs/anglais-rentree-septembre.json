  "grammar": [
    {
      "id": "g1",
      "titre": "L'impératif",
      "explication": "On utilise l'impératif pour donner un ordre (Listen!), un conseil (Be careful.) ou interdire (Don't touch.). À la forme affirmative : base verbale + compléments (Close the door!). À la forme négative : Don't (Do not) + base verbale + compléments (Don't close the door). Attention : pas de « s » au verbe (Listen, pas Listens).",
      "exemples": [
        "Listen to the teacher!",
        "Be careful.",
        "Don't touch.",
        "Close the door!",
        "Don't run in the corridors."
      ],
      "exercices": [
