  "grammar": [
    {
      "id": "g1",
      "titre": "Le présent au pluriel : wir, ihr, sie",
      "explication": "Au pluriel, les pronoms sont wir (nous), ihr (vous) et sie (ils / elles). Il n'y a qu'un seul pronom sie pour des garçons, des filles ou un groupe mixte : c'est le contexte qui dit de qui on parle. Les terminaisons sont -en / -t / -en. Avec wir et sie, le verbe ressemble à l'infinitif (spielen → wir spielen, sie spielen). Avec ihr, on enlève -en et on met -t (ihr spielt). Sie avec une majuscule (vous de politesse) se conjugue comme sie pluriel.",
      "exemples": [
        "wir hören, ihr hört, sie hören",
        "wir machen, ihr macht, sie machen",
        "Wir schwimmen. Ihr schwimmt. Sie schwimmen."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Ihr ___ einen Podcast. (hören)",
          "reponse": "hört"
        },
        {
          "type": "trous",
          "phrase": "Wir ___ Fußball. (spielen)",
          "reponse": "spielen"
        },
        {
          "type": "trous",
          "phrase": "Wo ___ ihr? (wohnen)",
          "reponse": "wohnt"
        },
        {
          "type": "choix",
          "question": "Ihr ___ schnell.",
          "options": ["schwimmen", "schwimmt", "schwimme"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "Alex und Lisa ___ über Mode.",
          "options": ["spricht", "sprechen", "sprecht"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "Quel pronom veut dire « nous » ?",
          "options": ["ihr", "wir", "sie"],
          "bonne": 1
        },
        {
          "type": "ordre",
          "mots": ["Wir", "spielen", "Tennis", "im", "Garten."]
        },
        {
          "type": "ordre",
          "mots": ["Ihr", "hört", "einen", "Podcast."]
        }
      ]
    },
    {
      "id": "g2",
      "titre": "Les auxiliaires sein et haben (et werden)",
      "explication": "Attention ! haben (avoir) est régulier au pluriel : wir haben, ihr habt, sie haben. Au singulier : ich habe, du hast, er / sie / es hat. sein (être) est irrégulier, il s'apprend par cœur : ich bin, du bist, er / sie / es ist, wir sind, ihr seid, sie / Sie sind. Ne les confonds pas : en français comme en allemand, on « a » une idée, des enfants, du temps → haben. werden veut dire « devenir » : ich werde, es wird (Im Oktober werde ich zwölf Jahre alt).",
      "exemples": [
        "Wir sind im Garten.",
        "Frau Wagner, haben Sie Kinder?",
        "Im September wird es kälter."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Wir ___ im Garten. (sein)",
