  "grammar": [
    {
      "id": "g1",
      "titre": "Le verbe BE (être)",
      "explication": "BE se conjugue : I am, you are, he/she/it is, we/you/they are. On peut faire des contractions à l'affirmatif (I'm, you're, he's...) et au négatif (isn't, aren't). À la forme interrogative, BE se place avant le sujet : Is she...? Are they...?",
      "exemples": [
        "She is alert and happy.",
        "The camel is not thirsty.",
        "Is she Spanish? No, she isn't Spanish."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "The camel ___ not thirsty. (be)",
          "reponse": "is"
        },
        {
          "type": "trous",
          "phrase": "Lions ___ hungry. (be)",
          "reponse": "are"
        },
        {
          "type": "trous",
          "phrase": "___ she Spanish? No, she isn't Spanish. (be)",
          "reponse": "Is"
        },
        {
          "type": "trous",
          "phrase": "___ they in the garden? No, they aren't in the garden. (be)",
          "reponse": "Are"
        },
        {
          "type": "choix",
          "question": "We ___ afraid of spiders.",
          "options": ["is", "are", "am"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "___ you OK?",
          "options": ["Is", "Am", "Are"],
          "bonne": 2
        },
        { "type": "ordre", "mots": ["She", "is", "alert", "and", "happy."] },
        { "type": "ordre", "mots": ["The", "camel", "is", "not", "thirsty."] }
      ]
    },
    {
      "id": "g2",
      "titre": "There is / There are (Il y a)",
      "explication": "Pour dire « il y a » : There is devant un nom singulier, There are devant un nom pluriel. À la forme négative : There isn't / There aren't, ou There is no / There are no.",
      "exemples": [
        "There is only one gym but we have a climbing wall.",
        "There are two gyms and one theatre.",
        "There aren't any lockers in the corridors."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "In my school there ___ one canteen. (be)",
          "reponse": "is"
        },
        {
          "type": "trous",
          "phrase": "There ___ two playgrounds and one lab. (be)",
          "reponse": "are"
        },
        {
          "type": "trous",
          "phrase": "___ there a library in your school? (be)",
          "reponse": "Is"
        },
        {
          "type": "trous",
          "phrase": "___ there any instruments in the music room? (be)",
          "reponse": "Are"
        },
        {
          "type": "choix",
          "question": "There ___ any lockers in the corridors.",
          "options": ["isn't", "aren't", "are"],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "In my school there ___ two IT rooms.",
          "options": ["is", "are", "be"],
          "bonne": 1
        },
        { "type": "ordre", "mots": ["There", "is", "a", "swimming", "pool."] },
        { "type": "ordre", "mots": ["There", "aren't", "any", "lockers."] }
      ]
    },
    {
      "id": "g3",
      "titre": "Exprimer ses goûts (love / like / hate)",
      "explication": "Pour dire ce qu'on aime, on utilise love (adorer), like (aimer) ou hate (détester) + nom ou verbe en -ing. À la 3e personne du singulier (he, she, it), on ajoute -s : loves, likes, hates. À la forme négative, on utilise doesn't / does not devant le verbe.",
      "exemples": [
        "She loves science because she likes doing experiments.",
        "Samuel hates tests.",
        "Samuel does not like to wear a uniform."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "She ___ science. (love)",
          "reponse": "loves"
        },
        {
          "type": "trous",
          "phrase": "Samuel ___ geography. (love)",
          "reponse": "loves"
        },
        {
          "type": "trous",
          "phrase": "My best friend, Tom, ___ foreign languages. (like)",
          "reponse": "likes"
        },
        {
          "type": "trous",
          "phrase": "Hanna ___ like her new school. (négation)",
          "reponse": "does not"
        },
        {
          "type": "choix",
          "question": "You ___ playing football, and I love it.",
          "options": ["hate", "hates", "hating"],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "Do you ___ acting?",
          "options": ["like", "likes"],
          "bonne": 0
        },
        { "type": "ordre", "mots": ["Samuel", "hates", "tests."] },
        { "type": "ordre", "mots": ["She", "doesn't", "like", "football."] }
      ]
    },
    {
      "id": "g4",
      "titre": "Les quantifieurs (some, many, a lot of, not any, no)",
      "explication": "Pour exprimer la quantité : some (quelques, certains), many et a lot of (beaucoup de). À la négation, on utilise not any ou no pour dire qu'il n'y en a aucun.",
      "exemples": [
        "In my school, some students play badminton.",
        "In my school, many students play football, and a lot of students play hockey.",
        "There are not any trees. There are no trees."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "In my school, ___ students play badminton. (quelques)",
          "reponse": "some"
        },
        {
          "type": "trous",
          "phrase": "In my school, ___ students play football. (beaucoup)",
          "reponse": "many"
        },
        {
          "type": "trous",
          "phrase": "In our school there are ___ corridors. (beaucoup)",
          "reponse": "many"
        },
        {
          "type": "trous",
          "phrase": "There are ___ benches. (quelques)",
          "reponse": "some"
        },
        {
          "type": "choix",
          "question": "There are not ___ trees.",
          "options": ["any", "no", "some"],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "There are ___ trees. (négation complète)",
          "options": ["no", "any", "some"],
          "bonne": 0
        },
        {
          "type": "ordre",
          "mots": [
            "In",
            "my",
            "school,",
            "some",
            "students",
            "play",
            "badminton."
          ]
        },
        {
          "type": "ordre",
          "mots": ["A", "lot", "of", "students", "play", "hockey."]
        }
      ]
    },
    {
      "id": "g5",
      "titre": "Can / Must (les verbes modaux)",
      "explication": "CAN exprime la capacité ou la permission (pouvoir, savoir faire). MUST exprime l'obligation (devoir). Ils ne prennent jamais de -s et sont suivis du verbe sans « to ». Négation : can't, must not.",
      "exemples": [
        "We can play in the playground.",
        "He can swim but he can't drive a boat.",
        "We must not run in the corridors.",
        "They have to take the bus."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "We ___ play in the playground. (pouvoir)",
          "reponse": "can"
        },
        {
          "type": "trous",
          "phrase": "He ___ swim but he can't drive a boat. (pouvoir)",
          "reponse": "can"
        },
        {
          "type": "trous",
          "phrase": "I ___ hear you, you have to repeat. (ne pas pouvoir)",
          "reponse": "can't"
        },
        {
          "type": "trous",
          "phrase": "We ___ not run in the corridors. (devoir)",
          "reponse": "must"
        },
        {
          "type": "choix",
          "question": "___ you speak English?",
          "options": ["Can", "Must", "Do"],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "They ___ to take the bus.",
          "options": ["must", "have", "can"],
          "bonne": 1
        },
        { "type": "ordre", "mots": ["Can", "you", "speak", "English?"] },
        {
          "type": "ordre",
          "mots": ["We", "must", "not", "run", "in", "the", "corridors."]
        }
      ]
    },
    {
      "id": "g6",
      "titre": "Le prétérit (raconter le passé)",
      "explication": "Pour raconter des actions passées, les verbes réguliers prennent -ed (celebrate ➜ celebrated). Les verbes irréguliers changent de forme et se retiennent par cœur (go ➜ went). Pour poser une question au passé, on utilise did + base verbale.",
      "exemples": [
        "What did you do during the holidays?",
        "I went to Normandy.",
        "And I celebrated Halloween."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "What ___ you do during the holidays? (do)",
          "reponse": "did"
        },
        {
          "type": "trous",
          "phrase": "I ___ to Normandy during the holidays. (go)",
          "reponse": "went"
        },
        {
          "type": "trous",
          "phrase": "I ___ Halloween with my friends. (celebrate)",
          "reponse": "celebrated"
        },
        {
          "type": "choix",
          "question": "Yesterday, I ___ to the fun fair.",
          "options": ["go", "goed", "went"],
          "bonne": 2
        },
        {
          "type": "choix",
          "question": "Last week, she ___ her birthday.",
          "options": ["celebrate", "celebrated", "celebrating"],
          "bonne": 1
        },
        { "type": "ordre", "mots": ["I", "went", "to", "Normandy."] },
        { "type": "ordre", "mots": ["I", "celebrated", "Halloween."] }
      ]
    }
  ],
