  "grammar": [
    {
      "id": "g1",
      "titre": "L'adjectif épithète au nominatif",
      "explication": "En allemand, l'adjectif épithète est toujours placé devant le nom qu'il qualifie. Comme en français, il s'accorde : il prend une marque (une terminaison). Au nominatif (le sujet), après l'article défini : der blaue Pulli, das blaue Kleid, die blaue Hose, die blauen Schuhe (pluriel).",
      "exemples": [
        "Der blaue Pulli ist schick.",
        "Das blaue Kleid ist cool.",
        "Die blaue Hose ist schick.",
        "Die braunen Schuhe sind praktisch."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Der ___ Pulli ist warm. (blau)",
          "reponse": "blaue"
        },
        {
          "type": "trous",
          "phrase": "Das ___ Kleid ist cool. (rot)",
          "reponse": "rote"
        },
        {
          "type": "trous",
          "phrase": "Die ___ Hose ist schick. (schwarz)",
          "reponse": "schwarze"
        },
        {
          "type": "choix",
          "question": "Quelle phrase est correcte ?",
          "options": [
            "Die blaue Hose ist schick.",
            "Die blau Hose ist schick.",
            "Die blauen Hose ist schick."
          ],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "Au pluriel, après « die », l'adjectif se termine par :",
          "options": [
            "-e",
            "-en",
            "-es"
          ],
          "bonne": 1
        },
        {
          "type": "ordre",
          "mots": [
            "Die",
            "Sneakers",
            "sind",
            "braun."
          ]
        },
        {
          "type": "ordre",
          "mots": [
            "Der",
            "Skater-Look",
            "ist",
            "lässig."
          ]
        },
        {
          "type": "trous",
          "phrase": "Die ___ Schuhe sind originell. (braun, pluriel)",
          "reponse": "braunen"
        }
      ]
    },
    {
      "id": "g2",
      "titre": "L'adjectif épithète à l'accusatif",
      "explication": "Quand le groupe nominal est COD (accusatif), on choisit la marque de l'accusatif. Seul le masculin change : der -> den, ein -> einen. Après l'article défini : den blauen Pulli, das blaue Kleid, die blaue Hose, die blauen Schuhe. Après l'article indéfini : einen schönen Mantel, ein schönes Kleid, eine schöne Hose, Ø schöne Schuhe.",
      "exemples": [
        "Kauf dir den schönen Mantel.",
        "Kauf dir die schöne Hose.",
        "Kauf dir das schöne Kleid.",
        "Ich trage die schwarze Hose.",
        "Er trägt ein blaues T-Shirt."
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Ich kaufe den ___ Pulli. (blau)",
          "reponse": "blauen"
        },
        {
          "type": "trous",
          "phrase": "Ich trage die ___ Hose. (schwarz)",
          "reponse": "schwarze"
        },
        {
          "type": "trous",
          "phrase": "Ich trage das ___ T-Shirt. (gelb)",
          "reponse": "gelbe"
        },
        {
          "type": "choix",
          "question": "Quelle phrase est correcte ?",
          "options": [
            "Ich kaufe den blaue Pulli.",
            "Ich kaufe den blauen Pulli.",
            "Ich kaufe der blaue Pulli."
          ],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "Er trägt ___ blaues T-Shirt.",
          "options": [
            "ein",
            "einen",
            "eine"
          ],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "Kauf dir ___ schönen Mantel.",
          "options": [
            "der",
            "den",
            "das"
          ],
          "bonne": 1
        },
        {
          "type": "ordre",
          "mots": [
            "Ich",
            "trage",
            "die",
            "schwarze",
            "Hose."
          ]
        },
        {
          "type": "ordre",
          "mots": [
            "Ich",
            "kaufe",
            "das",
            "coole",
            "Kleid."
          ]
        }
      ]
    },
    {
      "id": "g3",
      "titre": "Nominatif ou accusatif ?",
      "explication": "Le nominatif est la fonction du sujet (celui qui fait l'action) ; l'accusatif est la fonction du COD (ce que l'on porte, achète, trouve). Avec tragen, kaufen, finden, le vêtement est au COD donc à l'accusatif. Au masculin : der (nominatif) -> den (accusatif).",
      "exemples": [
        "Der Pulli ist warm. (sujet)",
        "Ich trage den warmen Pulli. (COD)",
        "Die Hose ist schick. (sujet)",
        "Ich kaufe die blaue Hose. (COD)"
      ],
      "exercices": [
        {
          "type": "trous",
          "phrase": "Ich trage ___ warmen Pulli. (der)",
          "reponse": "den"
        },
        {
          "type": "trous",
          "phrase": "___ Pulli ist warm. (der)",
          "reponse": "Der"
        },
        {
          "type": "choix",
          "question": "Dans « Ich trage den Rucksack », « den Rucksack » est :",
          "options": [
            "sujet (nominatif)",
            "COD (accusatif)"
          ],
          "bonne": 1
        },
        {
          "type": "choix",
          "question": "Dans « Der Rucksack ist praktisch », « der Rucksack » est :",
          "options": [
            "sujet (nominatif)",
            "COD (accusatif)"
          ],
          "bonne": 0
        },
        {
          "type": "choix",
          "question": "Au féminin, nominatif et accusatif sont :",
          "options": [
            "identiques (die)",
            "différents (die / den)"
          ],
          "bonne": 0
        },
        {
          "type": "ordre",
          "mots": [
            "Ich",
            "kaufe",
            "den",
            "Rucksack."
          ]
        },
        {
          "type": "ordre",
          "mots": [
            "Ilias",
            "trägt",
            "die",
            "schwarze",
            "Hose."
          ]
        },
        {
          "type": "trous",
